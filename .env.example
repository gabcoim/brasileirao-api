# Este arquivo serve apenas como referencia.
# O Spring Boot nao carrega .env automaticamente neste projeto.
API_FOOTBALL_KEY=coloque_sua_chave_aqui
POSTGRES_PASSWORD=coloque_sua_senha_aqui
ADMIN_USERNAME=admin
ADMIN_PASSWORD=coloque_uma_senha_administrativa_forte_aqui

# Use estas tres variaveis no ambiente hospedado.
SPRING_DATASOURCE_URL=jdbc:postgresql://host-do-banco/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=usuario_do_banco
SPRING_DATASOURCE_PASSWORD=senha_do_banco
